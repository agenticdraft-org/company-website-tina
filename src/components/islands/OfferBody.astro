---
import StoryHero from '../sections/StoryHero.astro';
import OfferServices from '../sections/OfferServices.astro';
import OfferStack from '../sections/OfferStack.astro';
import OfferPricing from '../sections/OfferPricing.astro';
import Closing from '../sections/Closing.astro';
import type { CmsOffer } from '../../lib/data';

interface Props {
	data?: CmsOffer | null;
	locale?: string;
}

const { data, locale } = Astro.props;
---

<main id="main">
	<StoryHero hero={data?.hero} />
	<OfferServices services={data?.services} />
	<OfferStack stack={data?.stack} />
	<OfferPricing pricing={data?.pricing} {locale} />
	<Closing closing={data?.closing} />
</main>
